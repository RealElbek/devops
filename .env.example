# Copy:  cp .env.example .env      (.env is git-ignored — never commit real passwords)

# One database (and one password) per microservice
EVENT_DB_PASS=change_me_event_local
BOOKING_DB_PASS=change_me_booking_local
PAYMENT_DB_PASS=change_me_payment_local
TICKET_DB_PASS=change_me_ticket_local

# Host ports
HTTP_PORT=80
CADVISOR_PORT=8080

# Unpaid bookings release their seats after this many minutes
HOLD_MINUTES=10
# Create a demo event on first start
SEED_DEMO=true
LOG_LEVEL=INFO
